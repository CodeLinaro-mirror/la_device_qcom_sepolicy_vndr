#  vendor_aidl_camera_provider_qti service

type  vendor_aidl_camera_provider_qti, domain;
type  vendor_aidl_camera_provider_qti_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_aidl_camera_provider_qti)
vndbinder_use(vendor_aidl_camera_provider_qti)
hal_client_domain(vendor_aidl_camera_provider_qti, hal_graphics_allocator)
binder_call(vendor_aidl_camera_provider_qti, servicemanager)
allow vendor_aidl_camera_provider_qti vendor_dmabuf_system_heap_device:chr_file { open ioctl };
allow vendor_aidl_camera_provider_qti hal_graphics_composer_default:fd use;
allow vendor_aidl_camera_provider_qti vndbinder_device:chr_file rw_file_perms;
allow  vendor_aidl_camera_provider_qti vendor_camera_socket:dir search;
allow  vendor_aidl_camera_provider_qti vendor_camera_socket:sock_file create_file_perms;
allow  vendor_aidl_camera_provider_qti vendor_ais_server:unix_stream_socket connectto;
binder_call(vendor_aidl_camera_provider_qti,cameraserver)
allow vendor_aidl_camera_provider_qti gpu_device:chr_file rw_file_perms;
binder_call(vendor_aidl_camera_provider_qti,hal_graphics_allocator_default)
allow vendor_aidl_camera_provider_qti hal_graphics_allocator_default:fd use;
hal_server_domain(vendor_aidl_camera_provider_qti,hal_camera)
get_prop(vendor_aidl_camera_provider_qti,hwservicemanager_prop)
allow vendor_aidl_camera_provider_qti video_device:chr_file rw_file_perms;
allow vendor_aidl_camera_provider_qti vendor_camera_prop:file read;


userdebug_or_eng(`allow  vendor_aidl_camera_provider_qti vendor_sysfs_kpi:file w_file_perms;')
