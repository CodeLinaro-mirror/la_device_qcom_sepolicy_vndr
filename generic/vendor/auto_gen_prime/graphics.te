allow hal_evs_default gpu_device:dir { open read search };
allow hal_evs_default graphics_device:chr_file getattr;
allow hal_evs_default sysfs_gpu:dir search;
allow hal_evs_default sysfs_gpu:file { getattr open read };

# This branch does not define the SELinux memfd_file class and boots with
# memfd_class=0, so allocator memfds are still labeled through
# tmpfs_domain(hal_graphics_allocator_default) as
# hal_graphics_allocator_default_tmpfs. Scope access to the allocator-owned
# tmpfs type and to the observed display/framework consumers that receive
# those buffer FDs.
typeattribute hal_graphics_allocator_default_tmpfs mlstrustedobject;
allow hal_evs_default hal_graphics_allocator_default_tmpfs:file { map read write };
allow hal_graphics_composer_default hal_graphics_allocator_default_tmpfs:file write;
allow dumpstate hal_graphics_allocator_default_tmpfs:file read;
allow automotive_display_service_server hal_graphics_allocator_default_tmpfs:file { read write };
allow platform_app hal_graphics_allocator_default_tmpfs:file { map read write };
allow surfaceflinger hal_graphics_allocator_default_tmpfs:file { map read write };
allow surfaceflinger sysfs_gpu:dir search;
allow system_app hal_graphics_allocator_default_tmpfs:file { map read write };
allow system_server hal_graphics_allocator_default_tmpfs:file { read write };

allow platform_app sysfs_gpu:dir search;
allow system_app graphics_device:chr_file getattr;
allow system_app sysfs_gpu:dir search;
