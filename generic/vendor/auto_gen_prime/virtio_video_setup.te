type virtio_video_setup, domain;
type virtio_video_setup_exec, exec_type, vendor_file_type, file_type;

# Dedicated sysfs label for /sys/class/video4linux/ and the backing
# /sys/devices/platform/<addr>.virtio-mmio/video4linux/ subtrees.
type sysfs_video4linux, sysfs_type, fs_type;

init_daemon_domain(virtio_video_setup)

allow virtio_video_setup vendor_shell_exec:file rx_file_perms;

# Execute vendor toolbox commands used by the script (chmod, chown, cat)
allow virtio_video_setup vendor_toolbox_exec:file x_file_perms;

# Read /sys/class/video4linux/ directory and follow symlinks to device entries.
# Read the 'name' attribute file under each video4linux sysfs entry.
# Both the class directory (/sys/class/video4linux/) and the backing device
# paths (/sys/devices/platform/<addr>.virtio-mmio/video4linux/) are labeled
# sysfs_video4linux via the file_contexts entries added alongside this policy.
allow virtio_video_setup sysfs_video4linux:dir { open read search getattr };
allow virtio_video_setup sysfs_video4linux:lnk_file { getattr read };
allow virtio_video_setup sysfs_video4linux:file { open read getattr };

# Check existence of /dev/videoX character device nodes ([ -c "$dev" ])
# Apply chmod 0660 and chown media:mediadrm to matching video device nodes
allow virtio_video_setup video_device:chr_file { getattr setattr };

# CAP_CHOWN  – chown(2) to reassign device node ownership
# CAP_FOWNER – chmod(2) when the process fsuid does not match the file owner
# CAP_FSETID – chmod(2) kernel check to clear/preserve setuid/setgid bits
allow virtio_video_setup self:capability { chown fowner fsetid };
