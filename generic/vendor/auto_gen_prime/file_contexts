/dev/hvc0  u:object_r:serial_device:s0

/sys/devices/platform/[0-9a-fA-F]+\.virtio_blk_[^/]+/virtio[0-9]+/block(/.*)? u:object_r:sysfs_devices_block:s0

# Mesa/DRM entry points are loaded in-process by the graphics stack. Keep this
# list explicit and limited to files installed in the LA Prime vendor image.
/vendor/lib(64)?/libgallium_dri\.so  u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libdrm\.so  u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/vulkan\.virtio\.so  u:object_r:same_process_hal_file:s0
/vendor/bin/hw/android\.hardware\.composer\.hwc3-service\.drm  u:object_r:hal_graphics_composer_default_exec:s0
/vendor/bin/init_dev_config u:object_r:init_dev_config_exec:s0
/vendor/bin/load_dlkm  u:object_r:vendor_modinstall-sh_exec:s0
