/dev/hvc0  u:object_r:serial_device:s0

/sys/devices/platform/[0-9a-fA-F]+\.virtio_blk_[^/]+/virtio[0-9]+/block(/.*)? u:object_r:sysfs_devices_block:s0

# VirtIO-MMIO addresses are generated by the guest bootloader. Label the DRM
# subtree separately from parent uevent metadata used by libdrm discovery.
# The uevent pattern matches every VirtIO-MMIO device.
/sys/devices/platform/[0-9a-fA-F]+\.virtio-mmio/uevent  u:object_r:vendor_sysfs_virtio_uevent:s0
/sys/devices/platform/[0-9a-fA-F]+\.virtio-mmio/drm(/.*)?  u:object_r:vendor_sysfs_virtio_drm:s0

# Mesa/DRM entry points are loaded in-process by the graphics stack. Keep this
# list explicit and limited to files installed in the LA Prime vendor image.
/vendor/lib(64)?/libgallium_dri\.so  u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libdrm\.so  u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/vulkan\.virtio\.so  u:object_r:same_process_hal_file:s0
/vendor/bin/hw/android\.hardware\.composer\.hwc3-service\.drm  u:object_r:hal_graphics_composer_default_exec:s0
/vendor/bin/load_dlkm  u:object_r:vendor_modinstall-sh_exec:s0

# virtio_video_setup service script
/vendor/bin/virtio_video_setup\.sh  u:object_r:virtio_video_setup_exec:s0

# sysfs nodes accessed by virtio_video_setup.sh:
#   /sys/class/video4linux/        – V4L2 class directory and its videoX symlinks
#   /sys/devices/platform/<addr>.virtio-mmio/video4linux/ – video device
#       subtree where the kernel exposes the 'name' attribute file.
/sys/class/video4linux(/.*)?  u:object_r:sysfs_video4linux:s0
/sys/devices/platform/[0-9a-fA-F]+\.virtio-mmio/video4linux(/.*)?  u:object_r:sysfs_video4linux:s0

# v4l2_codec2 service
/vendor/bin/hw/android\.hardware\.media\.c2-service-v4l2(-32|-64) u:object_r:mediacodec_exec:s0
