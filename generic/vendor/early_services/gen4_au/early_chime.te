type early_chime, domain;
type early_chime_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(early_chime)

allow early_chime audio_device:dir rw_dir_perms;
allow early_chime audio_device:chr_file rw_file_perms;
allow early_chime vendor_early_services:dir r_dir_perms;
allow early_chime vendor_early_services:file r_file_perms;
binder_call(early_chime, vendor_audio_hal_plugin_service)
allow early_chime vendor_audio_hal_plugin_service_service:service_manager find;
