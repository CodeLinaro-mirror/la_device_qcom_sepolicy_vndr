type hal_nlinterceptor_default, domain;
hal_server_domain(hal_nlinterceptor_default, hal_nlinterceptor)

type hal_nlinterceptor_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_nlinterceptor_default)

get_prop(hal_nlinterceptor_default, vendor_wifi_prop)

# someip
allow hal_nlinterceptor_default vendor_someip_data_file:dir rw_dir_perms;
allow hal_nlinterceptor_default vendor_someip_data_file:file create_file_perms;
allow hal_nlinterceptor_default vendor_someip_data_file:sock_file create_file_perms;
allow hal_nlinterceptor_default vendor_someip_cfg_file:file r_file_perms;

allow hal_nlinterceptor_default self:udp_socket create_socket_perms;
allow hal_nlinterceptor_default port:udp_socket name_bind;
allow hal_nlinterceptor_default node:udp_socket node_bind;
allow hal_nlinterceptor_default fwmarkd_socket:sock_file write;
allow hal_nlinterceptor_default netd:unix_stream_socket connectto;

# permission {create_socket_perms_no_ioctl nlmsg_readpriv nlmsg_write}
# is allowed in /system/sepolicy/public/hal_nlinterceptor.te
allow hal_nlinterceptor_default self:netlink_route_socket nlmsg_read;

# allow hal_nlinterceptor_default connect to routing manager socket file
allow hal_nlinterceptor_default vendor_routing_manager_default:unix_stream_socket { connectto };
