type vendor_init-hibernate-resume-sh, domain;
type vendor_init-hibernate-resume-sh_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_init-hibernate-resume-sh)

allow vendor_init-hibernate-resume-sh vendor_shell_exec:file rx_file_perms;
allow vendor_init-hibernate-resume-sh vendor_toolbox_exec:file rx_file_perms;
userdebug_or_eng(`
allow vendor_init-hibernate-resume-sh kmsg_debug_device:chr_file {w_file_perms getattr ioctl };
')

# awk is  labeled as vendor_file
allow vendor_init-hibernate-resume-sh   vendor_file:file {execute_no_trans};
allow vendor_init-hibernate-resume-sh block_device:dir { getattr r_dir_perms};
allow vendor_init-hibernate-resume-sh vendor_hibernate_swap:blk_file {getattr};
allow vendor_init-hibernate-resume-sh vendor_sysfs_hibernate:file {w_file_perms r_file_perms};

