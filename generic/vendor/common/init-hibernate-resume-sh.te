type vendor_init-hibernate-resume-sh, domain;
type vendor_init-hibernate-resume-sh_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_init-hibernate-resume-sh)

allow vendor_init-hibernate-resume-sh vendor_shell_exec:file rx_file_perms;
allow vendor_init-hibernate-resume-sh vendor_toolbox_exec:file rx_file_perms;
