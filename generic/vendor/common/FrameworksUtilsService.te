starting_at_board_api(202504, `

type vendor_framework_utils_app_default, domain;
app_domain(vendor_framework_utils_app_default)

hal_server_domain_bypass(vendor_framework_utils_app_default, vendor_framework_utils_app)
hal_attribute_service(vendor_framework_utils_app, vendor_qesdk_vndservice)

binder_call(vendor_framework_utils_app_client, vendor_framework_utils_app_server)
binder_call(vendor_framework_utils_app_server, vendor_framework_utils_app_client)
allow vendor_framework_utils_app_client vendor_qesdk_vndservice:service_manager find;

binder_use(vendor_framework_utils_app_default)

allow vendor_framework_utils_app_default { app_api_service }:service_manager find;

')
