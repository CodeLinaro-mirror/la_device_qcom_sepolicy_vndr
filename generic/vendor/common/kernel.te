userdebug_or_eng(`
  allow kernel self:socket create;
  allow kernel self:qipcrtr_socket create;
')

# Access firmware_file
r_dir_file(kernel, firmware_file)

allow kernel firmware_file:filesystem  { relabelto relabelfrom  mount };

# access vendor_firmware_file
r_dir_file(kernel, vendor_firmware_file)

dontaudit kernel kernel:system module_request;

#Since early_init first stage is enforcing and in kernel domain,
#we need to allow kernel access to early services directory to
#re-exec early init.
allow kernel vendor_early_services:dir r_dir_perms;

#Allow early init first stage to log to kmesg
#To be removed once restorecon is up
allow kernel tmpfs:chr_file rw_file_perms;
allow kernel tmpfs:dir r_dir_perms;

#Allow earlyinit to read the commandline and update selinux mode
allow kernel proc_cmdline:file r_file_perms;

allow kernel sepolicy_file:file r_file_perms;

allow kernel userdata_block_device:blk_file { create setattr };
allow kernel device:chr_file { create setattr };
allow kernel device:dir create_dir_perms;
allow kernel self:capability mknod;
allow kernel vendor_debugfs_ipc:dir search;
allow kernel vendor_debugfs_wlan:dir search;
allow kernel vendor_sysfs_kpi:file { open write };
allow kernel vendor_early_services:file relabelto;
allow kernel vendor_esplash_exec:file relabelto;
allow kernel vendor_earlyVideo_exec:file relabelto;
allow kernel audio_device:dir create_dir_perms;
allow kernel audio_device:chr_file { create setattr };

allow kernel early_chime_exec:file relabelto;
allow kernel vendor_qcarcam_edrm_rvc_exec:file relabelto;
allow kernel vendor_ais_server_exec:file relabelto;
allow kernel rootfs:dir relabelfrom;
allow kernel vendor_early_services:dir relabelto;
allow kernel vendor_early_services:file r_file_perms;
allow kernel vendor_file:dir { open read relabelto };
allow kernel vendor_file:file relabelto;
allow kernel system_lib_file:dir relabelto;
allow kernel system_lib_file:file relabelto;
allow kernel vendor_early_services:lnk_file read;
allow kernel vendor_system_cpu:chr_file getattr;
allow kernel vendor_sysfs_pinctrl:blk_file setattr;
allow kernel device:blk_file mounton;
