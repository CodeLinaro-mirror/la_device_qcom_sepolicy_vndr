type vendor_init-qti-cam-sh, domain;
type vendor_init-qti-cam-sh_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_init-qti-cam-sh)

allow vendor_init-qti-cam-sh vendor_shell_exec:file rx_file_perms;
allow vendor_init-qti-cam-sh vendor_toolbox_exec:file rx_file_perms;

allow vendor_init-qti-cam-sh vendor_shell_exec:file { execute getattr map read };
allow vendor_init-qti-cam-sh vendor_toolbox_exec:file { execute execute_no_trans getattr open read };
allow vendor_init-qti-cam-sh vendor_ais_server:dir search;
allow vendor_init-qti-cam-sh vendor_ais_server:file r_file_perms;
allow vendor_init-qti-cam-sh vendor_ais_server:process signal;

allow vendor_init-qti-cam-sh self:process setexec;
set_prop(vendor_init-qti-cam-sh, vendor_camera_provider_restart_prop);
