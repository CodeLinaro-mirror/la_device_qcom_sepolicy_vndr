allow init {
    adsprpcd_file
    cache_file
    mnt_vendor_file
    storage_file
    vendor_vm_system_file
}:dir mounton;

# symlink /sdcard to backing block
allow init tmpfs:lnk_file create;

allow init tty_device:chr_file rw_file_perms;

allow init mnt_vendor_file:dir mounton;

allow init vendor_ab_block_device:lnk_file relabelto;

#Allow init to mount non-hlos partitions in A/B builds
allow init { bt_firmware_file vendor_firmware_file  firmware_file } :dir mounton;

allow init { bt_firmware_file firmware_file }:filesystem  { relabelfrom  mount };
allow { bt_firmware_file firmware_file  }self:filesystem associate;

allow init firmware_file:filesystem getattr;
allow init bt_firmware_file:filesystem getattr;

dontaudit init kernel:system module_request;

allow init sysfs_leds:lnk_file r_file_perms;

allow init socket_device:sock_file create_file_perms;

#Needed for restorecon. Init already has these permissions
#for generic block devices, but is unable to access those
#which have a custom lable added by us.
allow init {
    vendor_custom_ab_block_device
    boot_block_device
    vendor_xbl_block_device
    vendor_ssd_block_device
    vendor_modem_block_device
    vendor_mdtp_device
    vendor_vm_data_block_device
}:{ blk_file lnk_file } relabelto;

#Allow /sys access to write zram disksize
allow init sysfs_zram:dir r_dir_perms;
allow init sysfs_zram:file r_file_perms;

allow init vendor_sysfs_boot_adsp:file w_file_perms;

allow init bt_firmware_file:filesystem getattr;
allow init firmware_file:filesystem getattr;
allow init vendor_sysfs_usb_device:file w_file_perms;

# Search and write access for vendor_sysfs_graphics for backlight in recovery
recovery_only(`
allow init vendor_sysfs_graphics:file w_file_perms;
allow init vendor_sysfs_graphics:dir search;
allow init vendor_sysfs_usb_device:file w_file_perms;
')

allow init vendor_esplash_exec:file {r_file_perms execute};
domain_auto_trans(init, vendor_esplash_exec, vendor_esplash)
allow init vendor_earlyVideo_exec:file {r_file_perms execute};
domain_auto_trans(init, vendor_earlyVideo_exec, vendor_earlyVideo)

#Allow early init to read early_service directory
#To be removed once early_init is moved to its context
allow init vendor_early_services:dir r_dir_perms;
allow init vendor_early_services:file r_file_perms;

#Allow earlyinit to access early_services/bin
allow init vendor_early_services:lnk_file r_file_perms;

#Required by second stage of early-init
allow init kernel:process share;
allow init proc:dir mounton;

#Execute test app through early_init
allow init vendor_earlyinit_test_exec:file {r_file_perms execute};
domain_auto_trans(init, vendor_earlyinit_test_exec, earlyinit_test)

allow init tmpfs:chr_file rw_file_perms;
allow init tmpfs:dir r_dir_perms;

allow init device:chr_file { ioctl relabelfrom };
allow init vendor_sysfs_kpi:file { open write };

allow init self:capability {sys_module};
allow init vendor_file:system module_load;

allow init audio_device:dir relabelto;
allow init audio_device:chr_file relabelto;
allow audio_device device:filesystem associate;

#Execute ais_server,qcarcam test app and esplash through early_init
allow init vendor_ais_server_exec:file {r_file_perms execute};
domain_auto_trans(init, vendor_ais_server_exec, vendor_ais_server)
allow init vendor_qcarcam_edrm_rvc_exec:file {r_file_perms execute};
domain_auto_trans(init, vendor_qcarcam_edrm_rvc_exec,vendor_qcarcam_edrm_rvc)
allow init early_chime_exec:file {r_file_perms execute};
domain_auto_trans(init, early_chime_exec, early_chime)

#Relabing SE labels permission
#allow init device:chr_file relabelfrom;
allow init device:dir relabelfrom;
allow init graphics_device:chr_file relabelto;
allow graphics_device device:filesystem associate;
allow init kmsg_device:chr_file relabelto;
allow kmsg_device device:filesystem associate;
allow init random_device:chr_file relabelto;
allow random_device device:filesystem associate;
allow init null_device:chr_file relabelto;
allow null_device device:filesystem associate;
allow init video_device:chr_file relabelto;
allow video_device device:filesystem associate;
allow init vendor_camera_socket:dir relabelto;
allow vendor_camera_socket device:filesystem associate;
allow init ion_device:chr_file relabelto;
allow ion_device device:filesystem associate;
allow init gpu_device:chr_file relabelto;
allow gpu_device device:filesystem associate;
allow init tmpfs:chr_file rw_file_perms;
allow init tmpfs:dir r_dir_perms;
#allow init rootfs:file { create };

allow init vendor_sysfs_sda_block:file w_file_perms;
userdebug_or_eng(`
allow init debugfs_tracing_debug:dir mounton;
')
