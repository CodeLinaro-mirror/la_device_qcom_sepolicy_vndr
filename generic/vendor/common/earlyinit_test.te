type earlyinit_test, domain;
allow earlyinit_test tmpfs:dir r_dir_perms;
allow earlyinit_test tmpfs:file rw_file_perms;
allow earlyinit_test tmpfs:chr_file rw_file_perms;
allow earlyinit_test vendor_early_services:dir search;
allow earlyinit_test rootfs:file {r_file_perms execute};
allow earlyinit_test graphics_device:chr_file rw_file_perms;
allow earlyinit_test kmsg_device:chr_file rw_file_perms;
allow earlyinit_test vendor_camera_socket:dir rw_dir_perms;
allow earlyinit_test vendor_camera_socket:file {rw_file_perms create};
