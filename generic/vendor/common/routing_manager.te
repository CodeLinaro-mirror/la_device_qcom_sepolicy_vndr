type vendor_routing_manager_default, domain;
type vendor_routing_manager_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_routing_manager_default)
net_domain(vendor_routing_manager_default)

# someip
allow vendor_routing_manager_default vendor_someip_data_file:dir rw_dir_perms;
allow vendor_routing_manager_default vendor_someip_data_file:file create_file_perms;
allow vendor_routing_manager_default vendor_someip_data_file:sock_file create_file_perms;

allow vendor_routing_manager_default self:netlink_route_socket { read };

# allow routing manager connect to socket files created by other someip applications
allow vendor_routing_manager_default   hal_wifi_default:unix_stream_socket { connectto };
allow vendor_routing_manager_default   hal_nlinterceptor_default:unix_stream_socket { connectto };
allow vendor_routing_manager_default   hal_wifi_supplicant_default:unix_stream_socket { connectto };
allow vendor_routing_manager_default   hal_wifi_hostapd_default:unix_stream_socket { connectto };
allow vendor_routing_manager_default   hal_bluetooth_default:unix_stream_socket { connectto };
allow vendor_routing_manager_default   qtiwifi:unix_stream_socket { connectto };
