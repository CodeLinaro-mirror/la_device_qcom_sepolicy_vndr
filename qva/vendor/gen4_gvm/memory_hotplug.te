type vendor_memory_hotplug, domain;
type vendor_memory_hotplug_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_memory_hotplug)

allow vendor_memory_hotplug vendor_shell_exec:file { read open getattr map execute execute_no_trans };
allow vendor_memory_hotplug vendor_toolbox_exec:file { read open getattr map execute execute_no_trans };
allow vendor_memory_hotplug sysfs:dir r_dir_perms;
allow vendor_memory_hotplug vendor_sysfs_system_memory:dir r_dir_perms;
allow vendor_memory_hotplug vendor_sysfs_system_memory:file rw_file_perms;
allow vendor_memory_hotplug proc:dir r_dir_perms;
allow vendor_memory_hotplug proc_meminfo:file r_file_perms;
allow vendor_memory_hotplug proc:file rw_file_perms;