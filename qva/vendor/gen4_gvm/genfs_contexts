# Update genfs context with new USB XHCI path
dnl # $1 = soc prefix
dnl # $2 = combined soc and usb type (e.g., a600000.ssusb)
dnl # $3 = for controller dwc3
dnl # $4 = xhci-hcd number (decimal)
pushdef(`cf_usb_genfscon', `dnl
genfscon sysfs $1/$2/$3.dwc3/xhci-hcd.$4.auto/usb u:object_r:vendor_sysfs_usb_node:s0
')dnl

cf_usb_genfscon(`/devices/platform/soc', `a600000.ssusb', `a600000', `0')dnl
