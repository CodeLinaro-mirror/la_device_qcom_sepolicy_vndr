type vendor_hal_bluetooth_offload_qti, domain;
hal_server_domain(vendor_hal_bluetooth_offload_qti, vendor_hal_bluetooth_offload)

type vendor_hal_bluetooth_offload_qti_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_bluetooth_offload_qti)

# HwBinder IPC from clients into server, and callbacks
binder_call(vendor_hal_bluetooth_offload_client, vendor_hal_bluetooth_offload_server)
binder_call(vendor_hal_bluetooth_offload_server, vendor_hal_bluetooth_offload_client)

#Add hal_bluetooth_offload as hwservice
#internally does add_hwservice
#add_hwservice(vendor_hal_bluetooth_offload, vendor_hal_bluetooth_offload_hwservice)
hal_attribute_hwservice(vendor_hal_bluetooth_offload, vendor_hal_bluetooth_offload_hwservice)
#Allow bluetooth offload hal to interact with powerStateService
hal_client_domain(vendor_hal_bluetooth_offload_qti, vendor_hal_powerstateservice)

#Allow hwbinder usage
hwbinder_use(vendor_hal_bluetooth_offload)
#wakelock_use(vendor_hal_bluetooth_offload)

#Allow bluetooth_offload to access glink
allow vendor_hal_bluetooth_offload vendor_glink_slate_bt:chr_file rw_file_perms;

#Allow bluetooth_offload to access vendor files
allow vendor_hal_bluetooth_offload_qti vendor_bt_data_file:dir create_dir_perms;
allow vendor_hal_bluetooth_offload_qti vendor_bt_data_file:file create_file_perms;

#to read bluetooth prop
get_prop(vendor_hal_bluetooth_offload, vendor_bluetooth_prop);
