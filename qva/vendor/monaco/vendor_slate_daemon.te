#policy for slate daemon
type vendor_slate_daemon, domain;
type vendor_slate_daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_slate_daemon)

#Needed to slate communication
allow vendor_slate_daemon vendor_slate_daemon_device:chr_file rw_file_perms;
allow vendor_slate_daemon vendor_sysfs_ssr:chr_file r_file_perms;
allow vendor_slate_daemon vendor_glink_slate_dfu_device:chr_file rw_file_perms;
allow vendor_slate_daemon vendor_glink_slate_custom_data_device:chr_file rw_file_perms;

#Needed to pil loading
allow vendor_slate_daemon vendor_ssr_device:chr_file r_file_perms;
allow vendor_slate_daemon self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
set_prop(vendor_slate_daemon, vendor_slate_daemon_prop)
set_prop(vendor_slate_daemon, vendor_slate_boot_complete_prop)
set_prop(vendor_slate_daemon, vendor_qc_aon_dfu_update_prop)
get_prop(vendor_slate_daemon, vendor_qc_aon_prop)
r_dir_file(vendor_slate_daemon, vendor_sysfs_twm)
allow vendor_slate_daemon vendor_sysfs_twm:file r_file_perms;
#wakelock policy
wakelock_use(vendor_slate_daemon);

# Read dload_mode
allow vendor_slate_daemon vendor_sysfs_dload_mode:file r_file_perms;

