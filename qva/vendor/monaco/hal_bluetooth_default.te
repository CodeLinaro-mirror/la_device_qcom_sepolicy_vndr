allow hal_bluetooth_default vendor_sysfs_bt_uart:file w_file_perms;

userdebug_or_eng(`
    allow hal_bluetooth_default vendor_debugfs_ipc:dir r_dir_perms;
    allow hal_bluetooth_default vendor_debugfs_ipc:file r_file_perms;
')

#hal_bluetooth_default needs uevent socket permissions
allow hal_bluetooth_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
