# Define domain
type vendor_hal_displayoffload_default, domain;

hal_server_domain(vendor_hal_displayoffload_default, vendor_hal_displayoffload)

type vendor_hal_displayoffload_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_displayoffload_default)

allow vendor_hal_displayoffload vendor_glink_slate_display_ctrl_device:chr_file rw_file_perms;
allow vendor_hal_displayoffload vendor_glink_slate_display_data_device:chr_file rw_file_perms;
allow vendor_hal_displayoffload vendor_glink_slate_touch_ctrl_device:chr_file rw_file_perms;

allow vendor_hal_displayoffload_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# Rules for display HAL communication
vndbinder_use(vendor_hal_displayoffload_default);
binder_call(vendor_hal_displayoffload_default, hal_graphics_composer)
allow vendor_hal_displayoffload_default vendor_qdisplay_service:service_manager find;

r_dir_file(vendor_hal_displayoffload, vendor_sysfs_drm)
allow vendor_hal_displayoffload_default vendor_sysfs_drm:file w_file_perms;

r_dir_file(vendor_hal_displayoffload, vendor_sysfs_touch_offload)
allow vendor_hal_displayoffload_default vendor_sysfs_touch_offload:file w_file_perms;

set_prop(vendor_hal_displayoffload_default, vendor_slate_boot_complete_prop)
get_prop(vendor_hal_displayoffload_default, vendor_uioffload_logging_prop)

set_prop(vendor_hal_displayoffload_default, vendor_lefty_prop)

get_prop(vendor_hal_displayoffload_default, wrist_orientation_prop)
hal_client_domain(vendor_hal_displayoffload_default, hal_wristorientation)

get_prop(vendor_hal_displayoffload_default, vendor_qc_aon_prop)

#allow access to hal_allocator
hal_client_domain(vendor_hal_displayoffload_default, hal_allocator)

get_prop(vendor_hal_displayoffload_default, vendor_touch_offload_prop)

#wakelock policy
wakelock_use(vendor_hal_displayoffload_default);

# Allow reading/writing to '/data/vendor/displayoffload/*'
allow vendor_hal_displayoffload_default vendor_display_offload_data_file:dir create_dir_perms;
allow vendor_hal_displayoffload_default vendor_display_offload_data_file:file create_file_perms;

