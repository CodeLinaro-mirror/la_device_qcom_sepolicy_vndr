# Define domain
type vendor_hal_healthservices_qti, domain;
type vendor_hal_healthservices_qti_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_healthservices_qti);

hal_server_domain(vendor_hal_healthservices_qti, hal_healthservices);
allow vendor_hal_healthservices_qti self:{ socket qipcrtr_socket } create_socket_perms_no_ioctl;

# HwBinder IPC from clients into server, and callbacks
binder_call(hal_healthservices_client, hal_healthservices_server)
binder_call(hal_healthservices_server, hal_healthservices_client)
hal_attribute_hwservice(hal_healthservices, hal_healthservices_hwservice)

# wakelock policy
wakelock_use(vendor_hal_healthservices_qti);

# add glink channel access permissions
allow vendor_hal_healthservices_qti vendor_glink_slate_sso_hal_device:chr_file rw_file_perms;

allow vendor_hal_healthservices_qti mnt_vendor_file:dir search;
allow vendor_hal_healthservices_qti vendor_persist_sensors_file:dir rw_dir_perms;
allow vendor_hal_healthservices_qti vendor_persist_sensors_file:file create_file_perms;

#Allow WHS hal to interact with powerStateService
hal_client_domain(vendor_hal_healthservices_qti, vendor_hal_powerstateservice);

#Allow WHS hal to access sensorstore
allow vendor_hal_healthservices_qti block_device:dir search;
allow vendor_hal_healthservices_qti vendor_sensorstore_block_device:blk_file rw_file_perms;

#allow access to aon presence property
get_prop(vendor_hal_healthservices_qti, vendor_qc_aon_prop)

#allow access to whs property
get_prop(vendor_hal_healthservices_qti, vendor_whs_prop)
