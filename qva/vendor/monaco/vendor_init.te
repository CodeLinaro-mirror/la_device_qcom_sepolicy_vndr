# Allow vendor_init to get vendor_pasr_prop
get_prop(vendor_init, persist_debug_prop)

#Allow vendor_init to set whs property
set_prop(vendor_init, vendor_whs_prop)

#Allow vendor_init to access sysfile
allow vendor_init system_file:file { read getattr };
