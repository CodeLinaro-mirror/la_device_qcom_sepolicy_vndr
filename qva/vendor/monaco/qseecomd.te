# allow tee access register powerstate hal service
hal_client_domain(tee, vendor_hal_powerstateservice);
# allow tee access set vendor.keymaster.quickboot property
set_prop(tee, vendor_tee_km_quickboot)
# allow tee access set vendor.gk.quickboot property
set_prop(tee, vendor_tee_gk_quickboot)
# allow tee access set vendor.keymint.quickboot property
set_prop(tee, vendor_tee_keymint_quickboot)
# allow tee access set vendor.secure_element.quickboot property
set_prop(tee, vendor_se_quickboot)

#allow tee to read/write in sysfs_dsqb
allow tee sysfs_dsqb:file rw_file_perms;
#allow tee to read /dev/block/mmcblk0 for gpt listener
allow tee root_block_device:blk_file r_file_perms;
