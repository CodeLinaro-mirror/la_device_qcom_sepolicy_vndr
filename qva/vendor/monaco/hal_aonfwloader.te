# HwBinder IPC from clients into server, and callbacks
binder_call(vendor_hal_aonfwloader_client, vendor_hal_aonfwloader_server)
binder_call(vendor_hal_aonfwloader_server, vendor_hal_aonfwloader_client)

add_hwservice(vendor_hal_aonfwloader_server, vendor_hal_aonfwloader_hwservice);
allow vendor_hal_aonfwloader_client vendor_hal_aonfwloader_hwservice:hwservice_manager find;

