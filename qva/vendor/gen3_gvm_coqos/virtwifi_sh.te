type virtwifi_sh, domain;
type virtwifi_sh_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(virtwifi_sh)

allow virtwifi_sh vendor_shell_exec:file { rx_file_perms };
allow virtwifi_sh wifi_service:service_manager { find };

