# Define domain
type hal_displayoffload_default, domain;

hal_server_domain(hal_displayoffload_default, hal_displayoffload)

type hal_displayoffload_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_displayoffload_default)

allow hal_displayoffload glink_slate_display_ctrl_device:chr_file rw_file_perms;
allow hal_displayoffload glink_slate_display_data_device:chr_file rw_file_perms;

allow hal_displayoffload_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# Rules for display HAL communication
vndbinder_use(hal_displayoffload_default);
binder_call(hal_displayoffload_default, hal_graphics_composer)
allow hal_displayoffload_default vendor_qdisplay_service:service_manager find;

set_prop(hal_displayoffload_default, vendor_slate_boot_complete_prop)
get_prop(hal_displayoffload_default, vendor_uioffload_logging_prop)

#wakelock policy
wakelock_use(hal_displayoffload_default);
