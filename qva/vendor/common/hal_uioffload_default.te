# Define domain
type hal_uioffload_default, domain;

hal_server_domain(hal_uioffload_default, hal_uioffload)

type hal_uioffload_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_uioffload_default)

allow hal_uioffload glink_slate_display_ctrl_device:chr_file rw_file_perms;
allow hal_uioffload glink_slate_display_data_device:chr_file rw_file_perms;

allow hal_uioffload_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# Rules for UIOffload HAL communication
vndbinder_use(hal_uioffload_default);
binder_call(hal_uioffload_default, hal_graphics_composer)
allow hal_uioffload_default vendor_qdisplay_service:service_manager find;

set_prop(hal_uioffload_default, vendor_slate_boot_complete_prop)
get_prop(hal_uioffload_default, vendor_uioffload_logging_prop)

set_prop(hal_uioffload_default, vendor_lefty_prop)

get_prop(hal_uioffload_default, qc_aon_prop)

get_prop(hal_uioffload_default, vendor_watch_orientation_prop)
hal_client_domain(hal_uioffload_default, hal_watchorientation)

#wakelock policy
wakelock_use(hal_uioffload_default);
allow hal_uioffload_default vendor_sysfs_drm:file { open read };
