# Policy for /system/bin/cm_manager
type vendor_cm_manager, domain ;
type vendor_cm_manager_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_cm_manager)

# Allow to write conf

allow vendor_cm_manager dnsproxyd_socket:sock_file write;
allow vendor_cm_manager fwmarkd_socket:sock_file write;
allow vendor_cm_manager mnt_vendor_file:dir search;
allow vendor_cm_manager netd:unix_stream_socket connectto;
allow vendor_cm_manager port:tcp_socket name_connect;
allow vendor_cm_manager proc_version:file { getattr open read };
allow vendor_cm_manager self:tcp_socket { connect create getopt read write shutdown };
allow vendor_cm_manager vendor_persist_c2c_file:dir { search add_name write create open read remove_name};
allow vendor_cm_manager vendor_persist_c2c_file:file { getattr open read create write append rename unlink };
allow vendor_cm_manager self:udp_socket create;
allow vendor_cm_manager property_socket:sock_file write;
allow vendor_cm_manager init:unix_stream_socket connectto;
