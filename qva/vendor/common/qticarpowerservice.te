type vendor_qticarpower_app, domain, coredomain;
app_domain(vendor_qticarpower_app)

# Required for service start
allow vendor_qticarpower_app {
    activity_service
    carservice_service
    content_capture_service
    game_service
    netstats_service
    virtual_device_service
}:service_manager find;
allow vendor_qticarpower_app system_app_data_file:dir create_dir_perms;
allow vendor_qticarpower_app system_app_data_file:file create_file_perms;

# Grant usb node access
allow vendor_qticarpower_app vendor_sysfs_usb_device:file rw_file_perms;
allow vendor_qticarpower_app vendor_sysfs_usb_node:file rw_file_perms;
allow vendor_qticarpower_app vendor_sysfs_usb_node:dir r_dir_perms;
