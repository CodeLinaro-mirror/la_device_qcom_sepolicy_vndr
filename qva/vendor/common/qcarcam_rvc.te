type vendor_qcarcam_rvc, domain;
type vendor_qcarcam_rvc_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_qcarcam_rvc)

allow vendor_qcarcam_rvc vendor_qcx_server:unix_stream_socket connectto;
allow vendor_qcarcam_rvc self:capability { sys_nice sys_admin };
allow vendor_qcarcam_rvc vendor_camera_data_file:dir { search write add_name };
allow vendor_qcarcam_rvc vendor_camera_data_file:file { create read write open getattr };
allow vendor_qcarcam_rvc gpu_device:chr_file { open ioctl read write map };
allow vendor_qcarcam_rvc ion_device:chr_file { read write open ioctl map };
allow vendor_qcarcam_rvc graphics_device:chr_file { read write open ioctl map };
allow vendor_qcarcam_rvc vendor_camera_socket:dir { search add_name remove_name write };
allow vendor_qcarcam_rvc vendor_camera_socket:sock_file create_file_perms;
allow vendor_qcarcam_rvc boot_status_prop:file { read open };
allow vendor_qcarcam_rvc vendor_sysfs_heartbeat:file { write open getattr };
userdebug_or_eng(`
allow vendor_qcarcam_rvc vendor_sysfs_kpi:file w_file_perms;
allow vendor_qcarcam_rvc kmsg_device:chr_file { getattr ioctl open write };
')
