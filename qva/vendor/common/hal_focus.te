type vendor_hal_focus, domain;
type vendor_hal_focus_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_hal_focus)
hal_client_domain(vendor_hal_focus, hal_audio)
hal_server_domain(vendor_hal_focus,hal_audio)
vndbinder_use(vendor_hal_focus)
binder_call(vendor_hal_focus,servicemanager)

allow vendor_hal_focus vendor_hal_focus_service:service_manager find;
allow vendor_hal_focus vendor_hal_focus_service:service_manager add;
