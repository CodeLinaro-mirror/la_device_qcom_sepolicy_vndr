type vendor_qti_drm_smmu, domain;
type vendor_qti_drm_smmu_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_qti_drm_smmu)

allow vendor_qti_drm_smmu vendor_toolbox_exec:file execute_no_trans;

set_prop(vendor_qti_drm_smmu, vendor_drm_smmu_prop);
