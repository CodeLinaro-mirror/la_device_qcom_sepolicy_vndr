type vendor_softsku_qti, domain;

type vendor_softsku_qti_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_softsku_qti)

allow vendor_softsku_qti tee_device:chr_file rw_file_perms;
allow vendor_softsku_qti vendor_dmabuf_qseecom_heap_device:chr_file {read open ioctl};
allow vendor_softsku_qti self:capability { chown fsetid };
allow vendor_softsku_qti self:tcp_socket {create bind listen accept getopt read write};
allow vendor_softsku_qti port:tcp_socket { name_bind };
allow vendor_softsku_qti node:tcp_socket { node_bind };
allow vendor_softsku_qti netd:unix_stream_socket {connectto};
allow vendor_softsku_qti fwmarkd_socket:sock_file {write};
