# c2c_hub service
type vendor_dm, domain;
type vendor_dm_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_dm)

allow vendor_dm vendor_persist_data_file:dir search;
allow vendor_dm mnt_vendor_file:dir r_dir_perms;

allow vendor_dm self:udp_socket create_socket_perms;
allow vendor_dm self:tcp_socket { create read write connect getopt name_connect };
