# mosquitto service
type vendor_mosquitto, domain;
type vendor_mosquitto_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_mosquitto)

# Allow to write conf
allow vendor_mosquitto vendor_persist_data_file:dir { rw_dir_perms setattr };
allow vendor_mosquitto vendor_persist_data_file:file rw_file_perms;

allow vendor_mosquitto self:udp_socket create_socket_perms;
allow vendor_mosquitto self:tcp_socket { create read write connect getopt name_connect };
