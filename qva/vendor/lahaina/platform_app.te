#allow platform_app to read vendor_umd_prop
get_prop(platform_app, vendor_umd_prop)

# Allow platform apps to find and call UMD AIDL service instances.
allow platform_app vendor_hal_umd_qti_service:service_manager find;
binder_call(platform_app, vendor_hal_umd_qti)
