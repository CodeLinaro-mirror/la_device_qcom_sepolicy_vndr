# Allow vendor_thermal-engine to access sysfs thremal nodes
allow vendor_thermal-engine self:capability sys_admin;
allow vendor_thermal-engine sysfs_thermal:file rw_file_perms;

allow vendor_thermal-engine vendor_sysfs_scsi_host:file { read write open getattr };
