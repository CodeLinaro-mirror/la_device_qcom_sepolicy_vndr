# Define domain
type vendor_qrsloader, domain;
type vendor_qrsloader_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_qrsloader);

vndbinder_use(vendor_qrsloader);
binder_call(vendor_qrsloader, hwservicemanager)
hal_server_domain(vendor_qrsloader, vendor_hal_qrsloader)

allow vendor_qrsloader servicemanager:binder { call transfer };

allow vendor_qrsloader vendor_aidl_qrs_service:service_manager add;
allow vendor_qrsloader vendor_qms_service:service_manager find;
allow vendor_qrsloader vndbinder_device:chr_file rw_file_perms;

allow vndservicemanager vendor_qrsloader:binder call;

allow vendor_qrsloader vendor_qms:binder { call transfer };
allow vendor_qms vendor_qrsloader:binder call;
# binder_call(vendor_qms, vendor_qrsloader);

allow system_server vendor_aidl_qrs_service:service_manager find;

allow system_server vendor_qrsloader:binder { call transfer };
allow vendor_qrsloader system_server: binder call;
# binder_call(vendor_qrsloader, system_server);

get_prop(vendor_qrsloader, vendor_qrs_service_prop)