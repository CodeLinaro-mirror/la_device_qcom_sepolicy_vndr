type operation_measurement_service, domain;

# Domain to run operationmeasurement Service (com.qualcomm.qti.operationmeasurement)
app_domain(operation_measurement_service)

# Allow operationmeasurement Service to access certain system services.
allow operation_measurement_service activity_service:service_manager find;
allow operation_measurement_service bluetooth_manager_service:service_manager find;
allow operation_measurement_service  wifi_service:service_manager find;
allow operation_measurement_service surfaceflinger_service:service_manager find;
allow operation_measurement_service system_app_data_file:dir create_dir_perms;
allow operation_measurement_service system_app_data_file:{ file lnk_file } create_file_perms;
allow operation_measurement_service system_app_data_file:file { read write getattr };
allow operation_measurement_service system_app_data_file:dir { getattr search };
allow operation_measurement_service batterystats_service:service_manager find;
allow operation_measurement_service fs_bpf:dir search;
